# Sử dụng multi-stage build để tối ưu dung lượng cho Next.js Standalone
FROM node:20-alpine AS base

# 1. Install dependencies
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

# 2. Build Next.js
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Tạo biến môi trường rỗng để tránh lỗi build-time (nếu có)
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# 3. Production Image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy thư mục public
COPY --from=builder /app/public ./public

# Setup quyền cho .next
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Copy output standalone và file tĩnh (lưu ý: cần cấu hình output: "standalone" trong next.config.ts)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
ENV PORT=3000

# Lệnh khởi động
CMD ["node", "server.js"]
