DATABASE_URL=postgresql://postgres:postgres@localhost:5433/carbon_analyst

COHERE_API_KEY=
LLM_MODEL=command-a-03-2025
LLM_MAX_TOKENS=4096
VECTOR_DIMENSION=1536
EMBEDDING_MODEL=embed-v4.0
RERANK_MODEL=rerank-v3.5
# Nghỉ (giây) sau MỖI lần gọi Cohere Embed thành công, kể cả khi không bị rate limit — né giới hạn
# 40 calls/phút của gói Free Cohere. Cộng thêm đúng ngần này vào MỌI câu hỏi Quote Chat (embed query)
# và mọi lần embed chunk lúc crawl. Hạ về 0 CHỈ khi đã chắc chắn key đang ở gói trả phí (kiểm tra
# dashboard Cohere) — vẫn Free thì giữ nguyên, tránh 429 hàng loạt lúc crawl.
COHERE_EMBED_THROTTLE_SECONDS=1.5

CLASSIFIER_BACKEND=anthropic
CLASSIFY_CONCURRENCY=5

# Quote Chat (hỏi đáp đoạn bôi đen trong báo cáo) — luôn dùng Anthropic (cần
# ANTHROPIC_API_KEY, dùng client tools + server tool web_search — xem
# services/quote_chat.py). Đổi model qua ENV này nếu cần, không cần sửa code.
QUOTE_CHAT_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
EIA_API_KEY=

# --- File đính kèm Quote Chat (ảnh/PDF/Word) — MinIO (S3-compatible) ---
# MINIO_ENDPOINT PHẢI là host:port public-reachable từ trình duyệt (vd
# "storage.mcv.network" hoặc "sim.mcv.network:9000" sau reverse-proxy) —
# KHÔNG dùng hostname nội bộ docker "minio:9000". Xem docker-compose.yml
# (service `minio`) và core/config.py::Settings.minio_endpoint.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=quote-chat-attachments
MINIO_SECURE=false
# Dùng bởi docker-compose.yml (service `minio`) để khởi tạo tài khoản admin —
# thường trùng giá trị với MINIO_ACCESS_KEY/MINIO_SECRET_KEY ở trên.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Auth (admin panel + user login) ---
# Chuỗi random bất kỳ dùng để ký JWT session, vd: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Đặt tên đăng nhập admin tuỳ ý, và chạy `python -m scripts.generate_admin_hash`
# để lấy giá trị dán vào ADMIN_PASSWORD_HASH bên dưới.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# true khi deploy production sau HTTPS (cookie chỉ gửi qua kết nối mã hoá)
COOKIE_SECURE=false

# --- Email (OTP + digest Hot News) qua Resend ---
# API key tạo tại: https://resend.com/api-keys (quyền "Sending access" là đủ).
# EMAIL_FROM phải thuộc domain đã verify tại https://resend.com/domains (thêm bản ghi
# SPF/DKIM vào DNS) — KHÔNG dùng được @gmail.com. Test nhanh chưa có domain:
# EMAIL_FROM=onboarding@resend.dev (chỉ gửi được tới email chủ tài khoản Resend).
RESEND_API_KEY=
EMAIL_FROM=Carbon Analyst <noreply@mcv.network>

# --- Email digest Hot News (gửi sau mỗi đợt crawl, dùng chung Resend ở trên) ---
# Gửi tới mọi user is_active=True (mỗi người 1 email, chia lô ≤100/request). Xem services/hot_news_email.py.
HOT_NEWS_EMAIL_ENABLED=true
HOT_NEWS_EMAIL_MAX_AGE_HOURS=24
HOT_NEWS_EMAIL_BATCH_SIZE=100
# Link "Mở Carbon Analyst" trong email — để trống thì không hiện nút.
APP_BASE_URL=https://sim.mcv.network
